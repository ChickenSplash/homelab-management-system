APP_NAME=HMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# 30 days. A guest's account lasts as long as their session.
SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The sign-in site (this app) and the apps it sends people back to. Cookies ignore the port,
# so on localhost every app shares the session without SESSION_DOMAIN.
ACCOUNTS_URL=http://localhost:8000
CHAT_URL=http://localhost:5173
MUSIC_URL=

# Browser apps allowed to sign in with a session cookie (the chat-ui dev server is :5173).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

CACHE_STORE=database

# Run `php artisan queue:work` alongside `php artisan serve`.
QUEUE_CONNECTION=database

# Run `php artisan reverb:start` too. Generate the key and secret with `openssl rand -hex 16`.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hms
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
